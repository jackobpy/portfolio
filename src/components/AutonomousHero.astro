<figure
  class="autonomous-scene"
  aria-label="A low-poly autonomous vehicle following a planned trajectory on a quiet roadway"
>
  <div class="scene-top meta">
    <span><span class="dot"></span>Autonomous systems</span><span
      >01 / Motion planning</span
    >
  </div><div id="vehicle-scene">
    <div class="scene-fallback">
      <span class="fallback-axis">y ↑<br />└── x</span><svg
        viewBox="0 0 500 300"
        aria-hidden="true"
        ><path
          d="M-20 245C145 235 170 45 520 80M-20 280C140 270 198 95 520 117"
          stroke="#b7c7be"
          fill="none"></path><path
          d="M-20 263C150 253 179 70 520 98"
          stroke="#176b61"
          stroke-width="2"
          stroke-dasharray="5 7"
          fill="none"></path><circle cx="243" cy="116" r="7" fill="#176b61"
        ></circle><circle
          cx="243"
          cy="116"
          r="27"
          fill="none"
          stroke="#176b61"
          opacity=".25"></circle></svg
      >
    </div>
  </div><figcaption class="meta">
    <span>Perceive. Plan. Move.</span><button
      id="scene-toggle"
      hidden
      type="button"
      aria-pressed="false">Pause motion</button
    ><span class="scene-coordinate">x / y / θ</span>
  </figcaption>
</figure>
<style>
  .autonomous-scene {
    margin: 0;
    min-width: 0;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }
  .scene-top {
    display: flex;
    justify-content: space-between;
    gap: 10px;
    font-size: 10px;
    padding-top: 14px;
  }
  #vehicle-scene {
    height: 300px;
    position: relative;
  }
  #vehicle-scene :global(canvas) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .scene-fallback {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle, #c4d0c8 0.6px, transparent 1px);
    background-size: 20px 20px;
  }
  .fallback-axis {
    position: absolute;
    left: 18px;
    bottom: 20px;
    font: 11px var(--font-mono);
    color: var(--color-text-muted);
  }
  figcaption {
    display: flex;
    justify-content: space-between;
    gap: 10px;
    padding: 12px 0;
    font-size: 10px;
  }
  button {
    border: 0;
    padding: 0;
    background: none;
    color: var(--color-text-muted);
    font: inherit;
    text-transform: uppercase;
    letter-spacing: inherit;
  }
  button:hover {
    color: var(--color-accent);
  }
  @media (max-width: 800px) {
    .scene-top {
      font-size: 9px;
    }
    .scene-top > span:last-child {
      display: none;
    }
    .scene-coordinate {
      display: none;
    }
    #vehicle-scene {
      height: 260px;
    }
  }
  @media (max-width: 600px) {
    .scene-top > span:last-child {
      display: block;
    }
    #vehicle-scene {
      height: 260px;
    }
    .scene-top,
    figcaption {
      font-size: 10px;
    }
  }
</style>
<script>
  const host = document.getElementById("vehicle-scene");
  if (host) {
    const observer = new IntersectionObserver(
      async ([entry]) => {
        if (!entry.isIntersecting) return;
        observer.disconnect();
        try {
          const { mountScene } = await import("../lib/autonomous-scene");
          mountScene(host);
        } catch {
          /* Static trajectory remains available if enhancement cannot load. */
        }
      },
      { rootMargin: "100px" },
    );
    observer.observe(host);
  }
</script>
