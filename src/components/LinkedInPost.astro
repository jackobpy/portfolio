---
const { src } = Astro.props;
---

<div class="linkedin-post">
  <iframe
    src={src}
    height="668"
    width="504"
    title="Google Cloud project post on LinkedIn"
    loading="eager"
    allowfullscreen
    referrerpolicy="strict-origin-when-cross-origin"></iframe>
</div>
<style>
  .linkedin-post {
    width: 100%;
    max-width: 504px;
    margin: 1.5rem auto;
    height: 648px;
    overflow: hidden;
    border-radius: 4px;
  }
  iframe {
    display: block;
    width: 100%;
    height: 668px;
    border: 0;
    border-radius: 4px;
    background: #fff;
  }
</style>
