---
const { kind = "pipeline" } = Astro.props;
---

<svg viewBox="0 0 340 195" fill="none" aria-hidden="true"
  ><defs
    ><pattern
      id={`grid-${kind}`}
      width="18"
      height="18"
      patternUnits="userSpaceOnUse"
      ><circle cx="1" cy="1" r=".6" fill="#b7d4c5"></circle></pattern
    ></defs
  ><rect width="340" height="195" fill={`url(#grid-${kind})`}></rect>{
    kind === "pipeline" ? (
      <g stroke="#4f806c">
        <>
          <path d="M76 98H265M126 62V136M217 62V136" stroke-dasharray="3 5" />
          <rect x="34" y="75" width="68" height="46" rx="4" fill="#ffffff" />
          <rect
            x="137"
            y="65"
            width="68"
            height="66"
            rx="3"
            fill="var(--color-accent-subtle)"
            stroke="var(--color-accent)"
          />
          <rect x="239" y="75" width="68" height="46" rx="4" fill="#ffffff" />
          <path d="M48 88H86M48 98H77M48 108H81M154 85H188M154 97H181M154 109H186M252 89H293M252 99H285M252 109H289" />
          <circle cx="119" cy="98" r="3" fill="var(--color-accent)" />
          <circle cx="221" cy="98" r="3" fill="var(--color-accent)" />
        </>
      </g>
    ) : kind === "latent" ? (
      <g>
        {Array.from({ length: 48 }, (_, i) => {
          const a = i * 2.399;
          const r = 8 + Math.sqrt(i) * 7;
          return (
            <circle
              cx={85 + Math.cos(a) * r}
              cy={98 + Math.sin(a) * r * 0.8}
              r="2.2"
              fill="#5f987e"
              opacity=".7"
            />
          );
        })}
        <path d="M137 70L180 90M137 125L180 105M192 98H224" stroke="#4f806c" />
        <rect
          x="175"
          y="81"
          width="22"
          height="34"
          rx="3"
          stroke="var(--color-accent)"
          fill="var(--color-accent-subtle)"
        />
        {Array.from({ length: 24 }, (_, i) => (
          <circle
            cx={258 + Math.cos(i * 2.4) * (8 + i)}
            cy={98 + Math.sin(i * 2.4) * (8 + i) * 0.8}
            r="2.5"
            fill="var(--color-accent)"
          />
        ))}
      </g>
    ) : (
      <g transform="translate(165 100)">
        <path d="M-95 0H99M0 -66V67" stroke="#9dada4" />
        {[-2, -1, 0, 1, 2].map((i) => (
          <>
            <path
              d={`M${i * 22 - 38} -55L${i * 22 + 38} 55`}
              stroke="#adbbb1"
            />
            <path
              d={`M-83 ${i * 18 - 15}L83 ${i * 18 + 15}`}
              stroke="#adbbb1"
            />
          </>
        ))}
        <path d="M0 0L63 12M0 0L-26 -43" stroke="var(--color-accent)" stroke-width="2" />
        <>
          <path
            d="M54 6L63 12L53 16M-27 -33L-26 -43L-17 -38"
            stroke="var(--color-accent)"
            stroke-width="2"
          />
          <circle r="3" fill="var(--color-accent)" />
        </>
      </g>
    )
  }</svg
>
