---
import BaseLayout from "../layouts/BaseLayout.astro";
import AutonomousHero from "../components/AutonomousHero.astro";
import ProjectCard from "../components/ProjectCard.astro";
import ContentRow from "../components/ContentRow.astro";
import { entries } from "../lib/content";
import { profile } from "../lib/profile";
const projects = (await entries("projects"))
  .filter((e) => e.data.featured)
  .slice(0, 3);
const experience = (await entries("experience")).slice(0, 3);
const education = (await entries("education")).filter((e) => e.data.featured);
const writing = (await entries("writing"))
  .filter((e) => !e.data.sample)
  .slice(0, 3);
---

<BaseLayout
  ><section class="hero">
    <div>
      <div class="meta"><span class="dot"></span>Zürich, Switzerland</div><h1>
        Hi, I’m Jakub.<br /><span class="accent">Computer scientist.</span
        >
      </h1><p class="intro">{profile.intro}</p><div class="hero-links">
        <a class="button" href="/work"
          >My experience <span aria-hidden="true">↗</span></a
        ><a href="/cv">View CV <span aria-hidden="true">↗</span></a>
      </div>
    </div><AutonomousHero />
  </section><div class="current-strip">
    <div>
      <span class="meta">Currently pursuing</span><p>
        MSc Computer Science · ETH Zürich
      </p>
    </div><div>
      <span class="meta">Graduated</span><p>
        BSc Computer Science and Engineering · TU Delft
      </p>
    </div><div>
      <span class="meta">Interested in</span><p>
        Autonomous vehicles & intelligent systems
      </p>
    </div>
  </div><section class="section">
    <div class="section-head">
      <div>
        <span class="meta">01</span><h2>Selected projects</h2>
      </div><a class="text-link" href="/projects">All projects ↗</a>
    </div><div class="project-grid">
      {projects.map((entry) => <ProjectCard entry={entry} />)}
    </div>
  </section><div class="section-columns">
    <section class="section">
      <div class="section-head">
        <div>
          <span class="meta">02</span><h2>Experience</h2>
        </div><a class="text-link" href="/experience">All ↗</a>
      </div>{
        experience.map((entry) => <ContentRow entry={entry} showType={false} />)
      }
    </section><section class="section">
      <div class="section-head">
        <div>
          <span class="meta">03</span><h2>Education</h2>
        </div><a class="text-link" href="/education">All ↗</a>
      </div>{
        education.map((entry) => <ContentRow entry={entry} showType={false} />)
      }
    </section>
  </div><section class="section">
    <div class="section-head">
      <div>
        <span class="meta">04</span><h2>Writing</h2>
      </div><a class="text-link" href="/blog">All posts ↗</a>
    </div>{
      writing.length ? (
        writing.map((entry) => <ContentRow entry={entry} />)
      ) : (
        <p class="muted">No posts yet.</p>
      )
    }
  </section><section class="about-strip">
    <div>
      <span class="meta">05</span><h2 style="margin-top:15px">About me</h2>
    </div><div>
      <p>
        I’m interested in autonomous vehicles and machine learning. I also enjoy
        teaching and making animations that explain mathematics.
      </p><div class="hero-links">
        <a href="/about">More about me ↗</a><a href={`mailto:${profile.email}`}
          >Get in touch ↗</a
        >
      </div>
    </div>
  </section></BaseLayout
>
