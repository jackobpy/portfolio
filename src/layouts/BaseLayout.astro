---
import "../styles/global.css";
import { profile } from "../lib/profile";
interface Props {
  title?: string;
  description?: string;
  article?: { publishedAt: Date; updatedAt?: Date };
  noindex?: boolean;
}
const {
  title,
  description = profile.intro,
  article,
  noindex = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, "https://frechowicz.com");
const current = Astro.url.pathname;
const pageTitle = title
  ? `${title} — ${profile.name}`
  : `${profile.name} — Computer scientist`;
const nav = [
  ["Work", "/work"],
  ["Writing", "/writing"],
  ["About", "/about"],
  ["CV", "/cv"],
];
const structured = article
  ? {
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      headline: title,
      description,
      datePublished: article.publishedAt.toISOString(),
      dateModified: (article.updatedAt ?? article.publishedAt).toISOString(),
      author: {
        "@type": "Person",
        name: profile.name,
        url: "https://frechowicz.com",
      },
      mainEntityOfPage: canonical.href,
    }
  : {
      "@context": "https://schema.org",
      "@type": "Person",
      name: profile.name,
      url: "https://frechowicz.com",
      sameAs: [profile.linkedin],
    };
---

<!doctype html>
<html lang="en">
  <head
    ><meta charset="UTF-8" /><meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    /><meta name="description" content={description} /><title>
      {pageTitle}
    </title><link rel="canonical" href={canonical} /><link
      rel="icon"
      href="/favicon.svg"
      type="image/svg+xml"
    /><link rel="apple-touch-icon" href="/apple-touch-icon.png" /><meta
      property="og:title"
      content={pageTitle}
    /><meta property="og:description" content={description} /><meta
      property="og:url"
      content={canonical}
    /><meta property="og:type" content={article ? "article" : "website"} /><meta
      property="og:image"
      content="https://frechowicz.com/og-default.png"
    /><meta property="og:image:width" content="1200" /><meta
      property="og:image:height"
      content="630"
    /><meta name="twitter:card" content="summary_large_image" />{
      noindex && <meta name="robots" content="noindex" />
    }<link
      rel="alternate"
      type="application/rss+xml"
      title="Jakub Fręchowicz — Writing"
      href="/rss.xml"
    /><script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(structured).replace(/</g, "\\u003c")}
    /></head
  ><body
    ><a class="skip" href="#main">Skip to content</a><div class="container">
      <header class="site-header">
        <a class="identity" href="/"
          >Jakub Fręchowicz<span>Computer scientist</span></a
        ><nav class="nav" aria-label="Main navigation">
          {
            nav.map(([name, url]) => (
              <a
                href={url}
                aria-current={
                  current.startsWith(url) ||
                  (url === "/work" &&
                    /^\/(projects|education|experience)/.test(current))
                    ? "page"
                    : undefined
                }
              >
                {name}
                {name === "CV" && " ↗"}
              </a>
            ))
          }
        </nav>
      </header><main id="main"><slot /></main><footer class="site-footer">
        <span>© {new Date().getFullYear()} Jakub Fręchowicz</span><div
          class="footer-links"
        >
          <a href={`mailto:${profile.email}`}>Email ↗</a><a
            href={profile.linkedin}>LinkedIn ↗</a
          ><a href="/rss.xml">RSS ↗</a><a href="/cv">CV ↗</a>
        </div>
      </footer>
    </div></body
  >
</html>
